rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // ملاحظة أمنية مهمة:
    // التطبيق الحالي لا يستخدم Firebase Auth، بل يعتمد على
    // تسجيل الدخول برقم الهاتف عبر localStorage.
    // لذلك القواعد مفتوحة حالياً لضمان عمل التطبيق.
    // يُنصح بإضافة Firebase Auth لحماية البيانات.
    // ═══════════════════════════════════════════════════════════════

    // ─────────────────────────────────────────────
    // 1. الطلاب: بيانات التسجيل، الصور، الدرجات
    // ─────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 2. المعلمون: حسابات المعلمين
    // ─────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 3. الإعدادات: جميع إعدادات التطبيق
    // ─────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 4. المجموعات الدراسية
    // ─────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 5. الإعلانات والنصائح
    // ─────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 6. طلبات الالتحاق بالعام الجديد
    // ─────────────────────────────────────────────
    match /enrollmentRequests/{enrollmentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 7. طلبات الدفع / الإيصالات
    // ─────────────────────────────────────────────
    match /payment_requests/{paymentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 8. الحضور والغياب
    // ─────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 9. الأعمال التعليمية (الكتب والمراجع)
    // ─────────────────────────────────────────────
    match /educationalWorks/{workId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 10. مشتريات الأعمال التعليمية
    // ─────────────────────────────────────────────
    match /workbookPurchases/{purchaseId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 11. الدورات الصيفية
    // ─────────────────────────────────────────────
    match /summerCourses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 12. اشتراكات الدورات الصيفية
    // ─────────────────────────────────────────────
    match /courseSubscriptions/{subscriptionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 13. التطبيقات المصغرة (Web Apps)
    // ─────────────────────────────────────────────
    match /webApps/{appId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 14. المحفظة / الأعمال
    // ─────────────────────────────────────────────
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────
    // 15. الدروس والمحتوى التعليمي
    // ─────────────────────────────────────────────
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
