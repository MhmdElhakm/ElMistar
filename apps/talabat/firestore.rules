rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function shortStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // ── Homes & Family Shared Workspace ──
    match /homes/{homeId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.home is map
        && request.resource.data.keys().hasAll(['home'])
        && request.resource.data.size() <= 45;
      allow delete: if false;
    }

    // ── User Profiles ──
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data is map
        && request.resource.data.size() <= 25;
      allow delete: if false;
    }

    // ── Orders (Shopping Requests) ──
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update: if request.resource.data is map
        && request.resource.data.size() <= 30
        && shortStr(request.resource.data.name, 200);
      allow delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
