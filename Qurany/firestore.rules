rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ملف المستخدم الخاص: لا يقرؤه ولا يكتبه غيره.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // لوحة المتصدرين: يقرؤها أي مستخدم (ولو مجهولًا)، ويكتب كل مستخدم مستنده فقط
    // مع التحقق من شكل البيانات وحدودها حتى لا تُستغل اللوحة لتخزين محتوى اعتباطي.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'auto', 'avatar', 'totalPoints', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints >= 0
        && request.resource.data.totalPoints <= 10000000
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 150000));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== الحساب برقم الهاتف فقط (معرّف المستند = بصمة SHA-256 للرقم) + نسخة بيانات التقدم =====
    // مستند الحساب يقرؤه صاحبه فقط. "الاستلام" (claim) يسمح لمن يعرف رقم الهاتف بنقل الملكية لجهازه
    // (دخول بالرقم دون رمز تحقق). للأمان الأعلى فعّل مصادقة الهاتف (OTP) واستبدل شرط الاستلام.
    function validAccount(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'phone', 'phoneHash', 'enc', 'data', 'updatedAt', 'claimPhoneHash'])
        && d.phoneHash is string && d.phoneHash.size() == 64
        && d.enc in ['gz', 'raw']
        && d.data is string && d.data.size() <= 800000;
    }

    match /accounts/{accountId} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.phoneHash == accountId
        && validAccount(request.resource.data);
      allow update: if request.auth != null && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.phoneHash == resource.data.phoneHash
          && validAccount(request.resource.data))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'claimPhoneHash'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.claimPhoneHash == resource.data.phoneHash)
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // مؤشر وجود الحساب (لا يحوي أي بيانات شخصية): يُعرف به هل الرقم مسجَّل أم جديد.
    match /phoneIndex/{phoneHash} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && phoneHash.size() == 64
        && request.resource.data.keys().hasOnly(['ownerUid', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accounts/$(phoneHash)).data.phoneHash == phoneHash;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accounts/$(phoneHash)).data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // قديم: فهرس الحسابات السابقة (اسم + هاتف) — حذف فقط لتنظيف الحسابات القديمة.
      match /accounts/{accountId} {
        allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
